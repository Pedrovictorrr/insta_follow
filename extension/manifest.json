{
  "manifest_version": 3,
  "name": "ig-lists connector",
  "version": "1.0",
  "description": "Envia a sessão do Instagram para o ig-lists rodando na sua própria máquina.",
  "permissions": ["cookies", "storage"],
  "host_permissions": [
    "https://*.instagram.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Enviar sessão para o ig-lists"
  }
}
